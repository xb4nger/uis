                local RealSlider = Items["RealSlider"].Instance
                local SizeX = (Input.Position.X - RealSlider.AbsolutePosition.X) / RealSlider.AbsoluteSize.X
                local Value = ((Slider.Max - Slider.Min) * SizeX) + Slider.Min

