                }):AddToTheme({TextColor3 = 'Inactive Text'})

                Items["KeybindWindow"] = Library:Create("TextButton", {
                    Name = "\0",
                    FontFace = Library.Font,
                    TextSize = Library.FontSize,
                    Parent = Library.UnusedHolder.Instance,
                    TextColor3 = Color3.fromRGB(0, 0, 0),
                    Text = "",
                    AutoButtonColor = false,
                    Size = UDim2.new(0, 220, 0, 0),
                    Position = UDim2.new(0, 1036, 0, 100),
                    BorderSizePixel = 0,
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundColor3 = Library.Theme["Inline"]
                }):AddToTheme({BackgroundColor3 = 'Inline'})

                Panel(Items["KeybindWindow"].Instance)

                Library:Create("UIPadding", {
                    Name = "\0",
                    Parent = Items["KeybindWindow"].Instance,
                    PaddingTop = UDim.new(0, 8),
                    PaddingBottom = UDim.new(0, 8),
                    PaddingRight = UDim.new(0, 8),
                    PaddingLeft = UDim.new(0, 8)
                })

                Library:Create("UIListLayout", {
                    Name = "\0",
                    Parent = Items["KeybindWindow"].Instance,
                    Padding = UDim.new(0, 6),
                    SortOrder = Enum.SortOrder.LayoutOrder
                })

                Keybind.Items = Items
            end

            Keybind.Holder = Items["KeybindWindow"]

            local Debounce = false
            local KeybindWindow = Items["KeybindWindow"].Instance
            local KeyButton = Items["KeyButton"].Instance

            local IsSettings = Data.Section and Data.Section.IsSettings

            local GetWindowX = function()
                local MaxX = Library.Holder.Instance.AbsoluteSize.X - KeybindWindow.Size.X.Offset - 8
                return math.clamp(KeyButton.AbsolutePosition.X, 8, math.max(MaxX, 8))
            end

            function Keybind:SetOpen(Bool)
                if Debounce then
                    return
                end

                Keybind.IsOpen = Bool

                Debounce = true

                local X = GetWindowX()
                local BaseY = KeyButton.AbsolutePosition.Y + KeyButton.AbsoluteSize.Y + GuiInset

                if Keybind.IsOpen then
                    KeybindWindow.Position = UDim2.new(0, X, 0, BaseY)

                    KeybindWindow.Parent = Library.Holder.Instance
                    Items["KeybindWindow"]:Tween({Position = UDim2.new(0, X, 0, BaseY + 10)})

                    Items["KeybindWindow"]:FadeDescendants(true, function()
                        Debounce = false
                    end)

                    for _, Value in Library.OpenFrames do
                        if Value ~= IsSettings then
                            Value:SetOpen(false)
                        end
                    end

                    Library.OpenFrames[Keybind] = Keybind
                else
                    Items["KeybindWindow"]:Tween({Position = UDim2.new(0, X, 0, BaseY - 10)})
                    Items["KeybindWindow"]:FadeDescendants(false, function()
                        Items["KeybindWindow"].Instance.Parent = Library.UnusedHolder.Instance
                        Debounce = false
                    end)

                    if Library.OpenFrames[Keybind] then
                        Library.OpenFrames[Keybind] = nil
                    end
                end

                local Descendants = KeybindWindow:GetDescendants()
                table.insert(Descendants, KeybindWindow)

                for _, Value in Descendants do
                    if Value.ClassName:find("UI") then
                        continue
                    end

                    if IsSettings then
                        Value.ZIndex = Keybind.IsOpen and Library.ZIndexOrder.KeybindWindow or 1
                    else
                        Value.ZIndex = Keybind.IsOpen and Library.ZIndexOrder.KeybindWindow + 1 or 1
                    end
                end
            end

            function Keybind:SetMode()
                Flags[Keybind.Flag] = {
                    Mode = Keybind.Mode,
                    Key = Keybind.Key,
                    Toggled = Keybind.Toggled
                }

                if Data.Callback then
                    Library:SafeCall(Data.Callback, Keybind.Toggled)
                end
            end

            local KeybindObject

            if Library.KeyList then
                KeybindObject = Library.KeyList:Add("", "")
            end

            local Update = function()
                if KeybindObject then
                    KeybindObject:Set(Data.Name, Keybind.Value, Keybind.Mode)
                    KeybindObject:SetStatus(Keybind.Toggled)
                end
            end

            local ModeDropdown

            ModeDropdown = Library:Dropdown({
                Name = "Mode",
                Flag = Keybind.Flag .. "ModeDropdown",
                Parent = Items["KeybindWindow"],
                Items = { "Toggle", "Hold", "Always" },
                Default = "Toggle",
                Callback = function(Value)
                    Keybind.Mode = Value

                    Keybind:SetMode()

                    if Value == "Always" then
                        Keybind:Press(true)
                    end

                    Items["KeyButton"].Instance.Text = Keybind.Mode .. ": " .. Keybind.Value
                    Update()
                end
            })

            Library:Toggle({
                Name = "Show In Keybinds List",
                Flag = Keybind.Flag .. "ShowInKeybindsList",
                Parent = Items["KeybindWindow"],
                Default = true,
                Callback = function(Value)
                    if KeybindObject then
                        KeybindObject:SetVis(Value)
                    end
                end
            })

            function Keybind:Disable()
                Keybind.Toggled = false

                Flags[Keybind.Flag] = {
                    Mode = Keybind.Mode,
                    Key = Keybind.Key,
                    Toggled = false
                }

                if Data.Callback then
                    Library:SafeCall(Data.Callback, false)
                end

                Update()
            end

            function Keybind:Press(Bool)
                if Keybind.Mode == "Toggle" then
                    Keybind.Toggled = not Keybind.Toggled
                elseif Keybind.Mode == "Hold" then
                    Keybind.Toggled = Bool
                elseif Keybind.Mode == "Always" then
                    Keybind.Toggled = true
                end

                Flags[Keybind.Flag] = {
                    Mode = Keybind.Mode,
                    Key = Keybind.Key,
                    Toggled = Keybind.Toggled
                }

                if Data.Callback then
                    Library:SafeCall(Data.Callback, Keybind.Toggled)
                end

                Update()
            end

            function Keybind:Set(Key)
                if type(Key) ~= "table" and string.find(tostring(Key), "Enum") then
                    -- an Enum.KeyCode / Enum.UserInputType item (or its string form)
                    Keybind.Key = tostring(Key)

                    local Text = GetKeyText(Keybind.Key)

                    Keybind.Value = Text
                    Items["KeyButton"].Instance.Text = Keybind.Mode .. ": " .. Text

                    Flags[Keybind.Flag] = {
                        Mode = Keybind.Mode,
                        Key = Keybind.Key,
                        Toggled = Keybind.Toggled
                    }

                    if Data.Callback then
                        Library:SafeCall(Data.Callback, Keybind.Toggled)
                    end

                    Update()
                elseif type(Key) == "table" then
                    Keybind.Key = tostring(Key.Key)

                    -- go through the dropdown so the mode shown in the window stays in sync
                    local Mode = Key.Mode or "Toggle"

                    if table.find({"Toggle", "Hold", "Always"}, Mode) then
                        ModeDropdown:Set(Mode)
                    end

                    local Text = GetKeyText(Keybind.Key)

                    Keybind.Value = Text
                    Items["KeyButton"].Instance.Text = Keybind.Mode .. ": " .. Text

                    Keybind:SetMode()
                    Update()
                elseif table.find({"Toggle", "Hold", "Always"}, Key) then
                    ModeDropdown:Set(Key)
                    Update()
                end

                Keybind.Picking = false
            end

            Items["KeyButton"]:Connect("MouseButton1Click", function()
                Keybind.Picking = true

                Items["KeyButton"].Instance.Text = ". . ."

                local InputBegan
                InputBegan = UserInputService.InputBegan:Connect(function(Input)
                    if Input.UserInputType == Enum.UserInputType.Keyboard then
                        Keybind:Set(Input.KeyCode)
                    else
                        Keybind:Set(Input.UserInputType)
                    end

                    InputBegan:Disconnect()
                    InputBegan = nil
                end)
            end)

            Library:Connect(UserInputService.InputBegan, function(Input, GPE)
                if not GPE and not Keybind.Picking and Keybind.Value ~= "None" and Keybind.Value ~= "" then
                    if tostring(Input.KeyCode) == Keybind.Key or tostring(Input.UserInputType) == Keybind.Key then
                        if Keybind.Mode == "Toggle" then
                            Keybind:Press()
                        elseif Keybind.Mode == "Hold" or Keybind.Mode == "Always" then
                            Keybind:Press(true)
                        end
                    end
                end

                if Input.UserInputType == Enum.UserInputType.MouseButton1 then
                    if Keybind.IsOpen then
                        if not Items["KeybindWindow"]:IsMouseOverFrame() and not ModeDropdown.Items["OptionHolder"]:IsMouseOverFrame() then
                            Keybind:SetOpen(false)
                        end
                    end
                end
            end)

            Library:Connect(UserInputService.InputEnded, function(Input, GPE)
                if GPE then
                    return
                end

                if Keybind.Value == "None" or Keybind.Value == "" then
                    return
                end

                if tostring(Input.KeyCode) == Keybind.Key or tostring(Input.UserInputType) == Keybind.Key then
                    if Keybind.Mode == "Hold" then
                        Keybind:Press(false)
                    elseif Keybind.Mode == "Always" then
                        Keybind:Press(true)
                    end
                end
            end)

            Items["KeyButton"]:Connect("MouseButton2Down", function()
                Keybind:SetOpen(not Keybind.IsOpen)
            end)

            if Data.Default then
                Keybind:Set({
                    Mode = Data.Mode or "Toggle",
                    Key = Data.Default,
                })
            end

            SetFlags[Keybind.Flag] = function(Value)
                Keybind:Set(Value)
            end

            table.insert(Library.Keybinds, Keybind)

            return Keybind, Items
        end

        Library.Watermark = function(Self, Params)
            Params = Params or { }

            local Watermark = {
                Name = Params.Name or Params.name or "Watermark",
                SubName = Params.SubName or Params.subname or "for diddy",

                Items = { },

                Fps = 60,
                Ping = 0,
                BindCallback = nil,
                BindInterval = 0.25
            }

            local Items = { } do
                Items["Watermark"] = Library:Create("Frame", {
                    Name = "\0",
                    Parent = Library.Holder.Instance,
                    AnchorPoint = Vector2.new(1, 0),
                    Position = UDim2.new(1, -10, 0, 10),
                    Size = UDim2.new(0, 0, 0, 25),
                    BorderSizePixel = 0,
                    AutomaticSize = Enum.AutomaticSize.X,
                    BackgroundColor3 = Library.Theme["Inline"]
                }):AddToTheme({BackgroundColor3 = 'Inline'})

                Items["Watermark"]:MakeDraggable()

                Stroke(Items["Watermark"].Instance, "Outline")
                Stroke(Items["Watermark"].Instance, "Outline 2", 1)

                Library:Create("UIListLayout", {
                    Name = "\0",
                    Parent = Items["Watermark"].Instance,
                    VerticalAlignment = Enum.VerticalAlignment.Center,
                    FillDirection = Enum.FillDirection.Horizontal,
                    Padding = UDim.new(0, 6),
                    SortOrder = Enum.SortOrder.LayoutOrder
                })

                Library:Create("UIPadding", {
                    Name = "\0",
                    Parent = Items["Watermark"].Instance,
                    PaddingTop = UDim.new(0, 6),
                    PaddingBottom = UDim.new(0, 6),
                    PaddingRight = UDim.new(0, 6),
                    PaddingLeft = UDim.new(0, 6)
                })

                -- TextWrapped is off on purpose: wrapped + AutomaticSize.X labels don't
                -- resize properly when their text changes
                Items["Text"] = Library:Create("TextLabel", {
                    Name = "\0",
                    FontFace = Font.fromEnum(Enum.Font.GothamBlack),
                    TextSize = 20,
                    Parent = Items["Watermark"].Instance,
                    TextColor3 = Library.Theme["Text"],
                    Text = Watermark.Name,
                    Size = UDim2.new(0, 0, 0, 15),
                    BorderSizePixel = 0,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, -2, 0, 0),
                    TextWrapped = false,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    RichText = true,
                    LayoutOrder = 1,
                    AutomaticSize = Enum.AutomaticSize.X
                }):AddToTheme({TextColor3 = 'Text'})

                Items["SubText"] = Library:Create("TextLabel", {
                    Name = "\0",
                    FontFace = Library.Font,
                    TextSize = Library.FontSize,
                    Parent = Items["Watermark"].Instance,
                    TextColor3 = Library.Theme["Text"],
                    Text = Watermark.SubName,
                    Size = UDim2.new(0, 0, 0, 15),
                    BorderSizePixel = 0,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, -2, 0, 0),
                    TextWrapped = false,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    RichText = true,
                    LayoutOrder = 2,
                    AutomaticSize = Enum.AutomaticSize.X
                }):AddToTheme({TextColor3 = 'Text'})

                Watermark.Items = Items
            end

            function Watermark:SetVisibility(Bool)
                Items["Watermark"].Instance.Visible = Bool
            end

            function Watermark:SetText(Text)
                Text = tostring(Text)

                if Items["Text"].Instance.Text ~= Text then
                    Items["Text"].Instance.Text = Text
                end
            end

            function Watermark:SetSubText(Text)
                Text = tostring(Text)

                if Items["SubText"].Instance.Text ~= Text then
                    Items["SubText"].Instance.Text = Text
                end
            end

            -- aliases so both naming styles work
            function Watermark:SetName(Text)
                Watermark:SetText(Text)
            end

            function Watermark:SetSubName(Text)
                Watermark:SetSubText(Text)
            end

            -- set both at once (pass nil to leave one unchanged)
            function Watermark:Update(Name, SubName)
                if Name ~= nil then
                    Watermark:SetText(Name)
                end

                if SubName ~= nil then
                    Watermark:SetSubText(SubName)
                end
            end

            -- Callback(Fps, Ping) -> string, shown as the subtext every Interval seconds
            function Watermark:Bind(Callback, Interval)
                Watermark.BindCallback = Callback
                Watermark.BindInterval = Interval or 0.25
            end

            function Watermark:Unbind()
                Watermark.BindCallback = nil
            end

            function Watermark:Destroy()
                Watermark.BindCallback = nil
                Items["Watermark"].Instance:Destroy()
            end

            -- converts the anchored position to plain offsets (needed for dragging) while
            -- keeping the right edge as the anchor, so the watermark grows to the left
            function Watermark:Center()
                task.wait()

                local Frame = Items["Watermark"].Instance
                local AbsPos, AbsSize = Frame.AbsolutePosition, Frame.AbsoluteSize

                Frame.AnchorPoint = Vector2.new(1, 0)
                Frame.Position = UDim2.new(0, AbsPos.X + AbsSize.X, 0, AbsPos.Y + GuiInset)
            end

            Watermark:Center()

            -- fps tracking + bound text updates
            do
                local Frames, Elapsed, SinceUpdate = 0, 0, 0

                Library:Connect(RunService.RenderStepped, function(Delta)
                    Frames += 1
                    Elapsed += Delta
                    SinceUpdate += Delta

                    if Elapsed >= 0.5 then
                        Watermark.Fps = math.floor(Frames / Elapsed + 0.5)
                        Frames, Elapsed = 0, 0
                    end

                    if Watermark.BindCallback and SinceUpdate >= Watermark.BindInterval then
                        SinceUpdate = 0

                        local Ok, Ping = pcall(function()
                            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
                        end)

                        Watermark.Ping = Ok and math.floor(Ping + 0.5) or 0

                        local Success, Result = pcall(Watermark.BindCallback, Watermark.Fps, Watermark.Ping)

                        if Success and Result ~= nil then
                            Watermark:SetSubText(Result)
                        end
                    end
                end)
            end

            Library.WatermarkObject = Watermark
            Self.WatermarkObject = Watermark

            return setmetatable(Watermark, Library)
        end

