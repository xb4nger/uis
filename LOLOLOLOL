    Library.Round = function(A, B, C)
        if type(A) ~= "number" then
            A, B = B, C
        end

        local Decimals = B or 0

        if Decimals <= 0 then
            return math.floor(A + 0.5)
        end

        local Multiplier = 10 ^ Decimals
        return math.floor(A * Multiplier + 0.5) / Multiplier
    end

