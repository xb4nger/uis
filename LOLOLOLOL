            function Window:ResizeTabs()
                local Sidebar = Items["Sidebar"] and Items["Sidebar"].Instance
                local PagesFrame = Items["Pages"] and Items["Pages"].Instance
                local MainFrame = Items["MainFrame"] and Items["MainFrame"].Instance

                if not Sidebar or not PagesFrame or not MainFrame then
                    return
                end

                local Count = #Window.Pages

                if Count <= 0 then
                    return
                end

                local ContentTop = 32
                local ContentBottomPad = 8
                local Available = math.max(MainFrame.AbsoluteSize.Y - ContentTop - ContentBottomPad, 100)

                local Padding = 6
                local SidePad = 4
                local PreferredH = 80
                local MinH = 58
                local MaxH = 90

                local NeededAtPreferred = (PreferredH * Count) + (Padding * math.max(Count - 1, 0)) + (SidePad * 2)
                local TabHeight

                if NeededAtPreferred <= Available then
                    TabHeight = PreferredH
                else
                    local Usable = Available - (SidePad * 2) - (Padding * math.max(Count - 1, 0))
                    TabHeight = math.clamp(math.floor(Usable / Count), MinH, MaxH)
                end

                local IconSize = math.clamp(math.floor(TabHeight * 0.42), 26, 34)
                local TitleY = IconSize + 10
                local TextSize = TabHeight >= 70 and 27 or 24

                for _, P in ipairs(Window.Pages) do
                    local Btn = P.Items and P.Items["Inactive"] and P.Items["Inactive"].Instance
                    local Icon = P.Items and P.Items["Icon"] and P.Items["Icon"].Instance
                    local Title = P.Items and P.Items["Title"] and P.Items["Title"].Instance

                    if Btn then
                        Btn.Size = UDim2.new(1, -4, 0, TabHeight)
                    end

                    if Icon then
                        Icon.Size = UDim2.new(0, IconSize, 0, IconSize)
                        Icon.Position = UDim2.new(0.5, 0, 0, math.floor((TabHeight - IconSize - 20) * 0.35))
                    end

                    if Title then
                        Title.TextSize = TextSize
                        Title.Size = UDim2.new(1, -4, 0, 30)
                        Title.Position = UDim2.new(0.5, 0, 0, TitleY)
                    end
                end

                local TotalH = (TabHeight * Count) + (Padding * math.max(Count - 1, 0)) + (SidePad * 2)
                TotalH = math.min(TotalH, Available)

                local YOffset = ContentTop + math.floor((Available - TotalH) * 0.5)
                Sidebar.Position = UDim2.new(0, 8, 0, YOffset)
                Sidebar.Size = UDim2.new(0, 56, 0, TotalH)
            end

            function Window:ResetPages()
                for _, Tab in Window.Pages do
                    Tab.Debounce = false

                    if Tab.Pages then
                        for _, Sub in Tab.Pages do
                            Sub.Debounce = false

                            if Tab.Current ~= Sub and Sub.Items and Sub.Items["Page"] then
                                Sub.Items["Page"].Instance.Parent = Library.UnusedHolder.Instance
                                Sub.Items["Page"].Instance.Visible = false
                                Sub.Items["Page"].Instance.Position = UDim2.new(0, 0, 0, 0)
                            end
                        end
                    end

                    if Window.Current ~= Tab and Tab.Items and Tab.Items["Page"] then
                        Tab.Items["Page"].Instance.Parent = Library.UnusedHolder.Instance
                        Tab.Items["Page"].Instance.Visible = false
                        Tab.Items["Page"].Instance.Position = UDim2.new(0, 0, 0, 0)
                    end
                end

                local Current = Window.Current

                if Current and Current.Items and Current.Items["Page"] then
                    Current.Items["Page"].Instance.Parent = Items["Content"].Instance
                    Current.Items["Page"].Instance.Visible = true
                    Current.Items["Page"].Instance.Position = UDim2.new(0, 0, 0, 0)

                    local CurrentSub = Current.Current

                    if CurrentSub and CurrentSub.Items and CurrentSub.Items["Page"] then
                        CurrentSub.Items["Page"].Instance.Parent = Current.Items["Columns"].Instance
                        CurrentSub.Items["Page"].Instance.Visible = true
                        CurrentSub.Items["Page"].Instance.Position = UDim2.new(0, 0, 0, 0)
                    end
                end
            end

            function Window:SetOpen(Bool)
                if Debounce then
                    return
                end

                Debounce = true

                Window.IsOpen = Bool
                Window:ClosePopups()
                Window:ResetPages()

                -- esp preview follows the menu: docks to the right on open, hides on close
                if Library.ESPPreviewObject and Library.ESPPreviewEnabled then
                    if Bool then
                        Library.ESPPreviewObject:Open()
                    else
                        Library.ESPPreviewObject:Close()
                    end
                end

                Items["MainFrame"]:FadeDescendants(Bool, function()
                    Debounce = false
                end)
            end

            function Window:Center()
                local AbsPos = Items["MainFrame"].Instance.AbsolutePosition
                Items["MainFrame"].Instance.AnchorPoint = Vector2.new(0, 0)
                task.wait()
                Items["MainFrame"].Instance.Position = UDim2.new(0, AbsPos.X, 0, AbsPos.Y + GuiInset)
            end

            Library:Connect(UserInputService.InputBegan, function(Input)
                if tostring(Input.KeyCode) == Library.MenuKeybind or tostring(Input.UserInputType) == Library.MenuKeybind then
                    if UserInputService:GetFocusedTextBox() then
                        return
                    end

                    Window:SetOpen(not Window.IsOpen)
                end
            end)

            Window:Center()
            Library.CurrentWindow = Window
            return setmetatable(Window, Library)
        end

