    Library.Exit = function(Self)
        local Lib = Library

        if not Lib or Lib.Exiting then
            return
        end

        Lib.Exiting = true

        -- close any open popups (dropdowns, colorpickers, keybind windows)
        pcall(function()
            for _, Value in Lib.OpenFrames do
                if Value and Value.SetOpen then
                    pcall(Value.SetOpen, Value, false)
                end
            end
        end)

        -- turn off every keybind (fires its callback with false)
        for _, Keybind in Lib.Keybinds do
            pcall(function()
                Keybind:Disable()
            end)
        end

        -- turn off every toggle (fires its callback with false)
        for _, Toggle in Lib.Toggles do
            pcall(function()
                if Toggle.Value then
                    Toggle:Set(false)
                else
                    Lib.Flags[Toggle.Flag] = false
                end
            end)
        end

        -- give any script loops a frame to see the flags go false
        task.wait()

        for _, Connection in Lib.Connections do
            pcall(function()
                Connection:Disconnect()
            end)
        end

        for _, Thread in Lib.Threads do
            pcall(coroutine.close, Thread)
        end

        pcall(function()
            if Lib.Holder then
                Lib.Holder.Instance:Destroy()
            end
        end)

        pcall(function()
            if Lib.UnusedHolder then
                Lib.UnusedHolder.Instance:Destroy()
            end
        end)

        -- NOTE: the local `Library` is intentionally NOT set to nil here.
        -- delayed callbacks inside the library still reference it, and niling it
        -- caused "attempt to index nil with 'Notifications' / 'Watermark' / ..."
        if getgenv().Library == Lib then
            getgenv().Library = nil
        end
    end

    Library.Create = function(Self, Class, Properties)
        local Data = {
            Class = Class,
            Properties = Properties,
            Instance = Instance.new(Class)
        }

        Data.Instance.Name = "\0"

        if Class == "TextButton" then
            Data.Instance.AutoButtonColor = false
            Data.Instance.Text = ""
        end

        local Parent = nil

        for Index, Property in Properties do
            if Index == "Parent" then
                Parent = Property
                continue
            end

            Data.Instance[Index] = Property
        end

        -- parent last so the instance doesn't re-layout on every property
        if Parent then
            Data.Instance.Parent = Parent
        end

        return setmetatable(Data, Library)
    end

    Library.Thread = function(Self, Function)
        local NewThread = coroutine.create(Function)

        table.insert(Library.Threads, NewThread)
        task.spawn(NewThread)

        return NewThread
    end

    Library.Connect = function(Self, Signal, Callback)
        local Connection

        if type(Signal) == "string" and Self.Instance then
            if IsMobile and Signal == "MouseButton1Down" then
                Connection = Self.Instance.InputBegan:Connect(function(Input)
                    if Input.UserInputType == Enum.UserInputType.Touch or Input.UserInputType == Enum.UserInputType.MouseButton1 then
                        Callback(Input)
                    end
                end)
            else
                Connection = Self.Instance[Signal]:Connect(Callback)
            end
        else
            Connection = Signal:Connect(Callback)
        end

        table.insert(Library.Connections, Connection)
        return Connection
    end

    Library.Tween = function(Self, Properties, Info, IsRawItem)
        local Object = Self.Instance or IsRawItem
        Info = Info or TweenInfo.new(Library.Animation.Time, Enum.EasingStyle[Library.Animation.Style], Enum.EasingDirection[Library.Animation.Direction])

        if not Object then
            return
        end

        local NewTween = TweenService:Create(Object, Info, Properties)
        NewTween:Play()

        return NewTween
    end

    Library.GetTweenProperty = function(Self, IsRawItem)
        local Object = Self.Instance or IsRawItem

        if not Object then
            return nil
        end

        if Object:IsA("Frame") then
            return { "BackgroundTransparency" }
        elseif Object:IsA("TextLabel") or Object:IsA("TextButton") then
            return { "TextTransparency", "BackgroundTransparency" }
        elseif Object:IsA("ImageLabel") or Object:IsA("ImageButton") then
            return { "BackgroundTransparency", "ImageTransparency" }
        elseif Object:IsA("ScrollingFrame") then
            return { "BackgroundTransparency", "ScrollBarImageTransparency" }
        elseif Object:IsA("TextBox") then
            return { "TextTransparency", "BackgroundTransparency" }
        elseif Object:IsA("UIStroke") then
            return { "Transparency" }
        end

        return nil
    end

    Library.Fade = function(Self, Property, Visibility, IsRawItem)
        local Object = Self.Instance or IsRawItem

        if not Object then
            return
        end

        local OrigAttr = "_Orig" .. Property
        local GenAttr = "_FadeGen" .. Property
        local BusyAttr = "_Fading" .. Property

        if not Object:GetAttribute(BusyAttr) or Object:GetAttribute(OrigAttr) == nil then
            Object:SetAttribute(OrigAttr, Object[Property])
        end

        local Original = Object:GetAttribute(OrigAttr)
        local Gen = (Object:GetAttribute(GenAttr) or 0) + 1
        Object:SetAttribute(GenAttr, Gen)
        Object:SetAttribute(BusyAttr, true)

        local NewTween

        if Visibility then
            Object[Property] = 1
            NewTween = Library:Tween({[Property] = Original}, nil, Object)
        else
            NewTween = Library:Tween({[Property] = 1}, nil, Object)
        end

        NewTween.Completed:Once(function()
            if Object:GetAttribute(GenAttr) ~= Gen then
                return
            end

            Object:SetAttribute(BusyAttr, nil)

            if not Visibility and Object.Parent then
                Object[Property] = Original
            end
        end)

        return NewTween
    end

    Library.FadeDescendants = function(Self, Visibility, Callback)
        local Root = Self.Instance
        local Gen = (Root:GetAttribute("_DescGen") or 0) + 1
        Root:SetAttribute("_DescGen", Gen)

        if Visibility then
            Root.Visible = true
        end

        local NewTween

        local Children = Root:GetDescendants()
        table.insert(Children, Root)

        for _, Child in Children do
            local TransparencyProperty = Library:GetTweenProperty(Child)

            if not TransparencyProperty then
                continue
            end

            for _, Property in TransparencyProperty do
                NewTween = Library:Fade(Property, Visibility, Child)
            end
        end

        if not NewTween then
            if Callback and type(Callback) == "function" then
                Callback()
            end

            Root.Visible = Visibility
            return
        end

        NewTween.Completed:Once(function()
            -- a newer fade on this same object took over, so don't let this stale one
            -- flip visibility (this is what caused flicker when switching tabs quickly)
            if Root:GetAttribute("_DescGen") ~= Gen then
                return
            end

            if Callback and type(Callback) == "function" then
                Callback()
            end

            Root.Visible = Visibility
        end)
    end

    Library.MakeDraggable = function(Self)
        if not Self.Instance then
            return
        end

        local Gui = Self.Instance
        local Dragging = false
        local DragStart
        local StartPosition

        local DragTween = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

        local Set = function(Input)
            local DragDelta = Input.Position - DragStart
            local NewX = StartPosition.X.Offset + DragDelta.X
            local NewY = StartPosition.Y.Offset + DragDelta.Y

            local ScreenSize = Gui.Parent.AbsoluteSize
            local GuiSize = Gui.AbsoluteSize
            local Anchor = Gui.AnchorPoint

            -- clamp respects the anchor point, so right/center anchored frames stay on screen too
            local MinX = Anchor.X * GuiSize.X
            local MaxX = ScreenSize.X - (1 - Anchor.X) * GuiSize.X
            local MinY = Anchor.Y * GuiSize.Y
            local MaxY = ScreenSize.Y - (1 - Anchor.Y) * GuiSize.Y

            NewX = math.clamp(NewX, MinX, math.max(MinX, MaxX))
            NewY = math.clamp(NewY, MinY, math.max(MinY, MaxY))

            Self:Tween({Position = UDim2.new(0, NewX, 0, NewY)}, DragTween)
        end

        local InputChanged

        Self:Connect("InputBegan", function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
                Dragging = true
                DragStart = Input.Position
                StartPosition = Gui.Position

                if InputChanged then
                    return
                end

                InputChanged = Input.Changed:Connect(function()
                    if Input.UserInputState == Enum.UserInputState.End then
                        Dragging = false
                        InputChanged:Disconnect()
                        InputChanged = nil
                    end
                end)
            end
        end)

        Library:Connect(UserInputService.InputChanged, function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
                if Dragging then
                    Set(Input)
                end
            end
        end)

        return Dragging
    end

    Library.MakeResizeable = function(Self, Minimum)
        if not Self.Instance then
            return
        end

        local Gui = Self.Instance

        local Resizing = false
        local CurrentSide = nil

        local StartMouse = nil
        local StartPosition = nil
        local StartSize = nil

        local EdgeThickness = 2
        local ResizeTween = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

        local MakeEdge = function(Position, Size)
            local Button = Library:Create("TextButton", {
                Name = "\0",
                Size = Size,
                Position = Position,
                BackgroundColor3 = Color3.fromRGB(166, 147, 243),
                BackgroundTransparency = 1,
                Text = "",
                BorderSizePixel = 0,
                AutoButtonColor = false,
                Parent = Gui,
                ZIndex = 99999,
            })

            Button:AddToTheme({BackgroundColor3 = "Accent"})

            return Button
        end

        local Edges = {
            { Button = MakeEdge(UDim2.new(0, 0, 0, 0), UDim2.new(0, EdgeThickness, 1, 0)), Side = "L" },
            { Button = MakeEdge(UDim2.new(1, -EdgeThickness, 0, 0), UDim2.new(0, EdgeThickness, 1, 0)), Side = "R" },
            { Button = MakeEdge(UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0, EdgeThickness)), Side = "T" },
            { Button = MakeEdge(UDim2.new(0, 0, 1, -EdgeThickness), UDim2.new(1, 0, 0, EdgeThickness)), Side = "B" },
        }

        local BeginResizing = function(Side)
            Resizing = true
            CurrentSide = Side

            StartMouse = UserInputService:GetMouseLocation()

            StartPosition = Vector2.new(Gui.Position.X.Offset, Gui.Position.Y.Offset)
            StartSize = Vector2.new(Gui.Size.X.Offset, Gui.Size.Y.Offset)

            for _, Value in Edges do
                Value.Button.Instance.BackgroundTransparency = (Value.Side == Side) and 0 or 1
            end
        end

        local EndResizing = function()
            Resizing = false
            CurrentSide = nil

            for _, Value in Edges do
                Value.Button.Instance.BackgroundTransparency = 1
            end
        end

        for _, Value in Edges do
            Value.Button:Connect("InputBegan", function(Input)
                if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
                    BeginResizing(Value.Side)
                end
            end)
        end

        Library:Connect(UserInputService.InputEnded, function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
                if Resizing then
                    EndResizing()
                end
            end
        end)

        Library:Connect(RunService.RenderStepped, function()
            if not Resizing or not CurrentSide then
                return
            end

            local MouseLocation = UserInputService:GetMouseLocation()
            local dx = MouseLocation.X - StartMouse.X
            local dy = MouseLocation.Y - StartMouse.Y

            local x, y = StartPosition.X, StartPosition.Y
            local w, h = StartSize.X, StartSize.Y

            if CurrentSide == "L" then
                x = StartPosition.X + dx
                w = StartSize.X - dx
            elseif CurrentSide == "R" then
                w = StartSize.X + dx
            elseif CurrentSide == "T" then
                y = StartPosition.Y + dy
                h = StartSize.Y - dy
            elseif CurrentSide == "B" then
                h = StartSize.Y + dy
            end

            if w < Minimum.X then
                if CurrentSide == "L" then
                    x = x - (Minimum.X - w)
                end

                w = Minimum.X
            end

            if h < Minimum.Y then
                if CurrentSide == "T" then
                    y = y - (Minimum.Y - h)
                end

                h = Minimum.Y
            end

            Self:Tween({Position = UDim2.fromOffset(x, y)}, ResizeTween)
            Self:Tween({Size = UDim2.fromOffset(w, h)}, ResizeTween)
        end)
    end

    Library.IsMouseOverFrame = function(Self)
        if not Self.Instance then
            return
        end

        local Object = Self.Instance

        local MousePosition = Vector2.new(Mouse.X, Mouse.Y)

